APP_NAME="FF Braak Fahrzeugbuchung"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ff88
DB_USERNAME=ff88
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=129600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mx2ff0.netcup.net
MAIL_PORT=465
MAIL_USERNAME=fahrzeugbuchung@feuerwehr-braak.de
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="fahrzeugbuchung@feuerwehr-braak.de"
MAIL_FROM_NAME="FF Braak Fahrzeugbuchung"

MAGIC_LINK_TTL_MINUTES=15

# Kommagetrennt; werden beim Container-Start als Admins angelegt/aktiviert
ADMIN_EMAILS=

# Phase 3 (optional Monitor-Ansicht)
# DISPLAY_TOKEN=

VITE_APP_NAME="${APP_NAME}"
